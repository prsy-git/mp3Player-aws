SESSION_SECRET=replace-with-a-random-secret
PORT=8080
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-database-password
POSTGRES_DATABASE=mp3player

# AWS S3
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
S3_BUCKET_NAME=replace-with-bucket-name

# Set to true to allow creation of new user accounts
ALLOW_REGISTRATION=false